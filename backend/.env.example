# Generate a local fingerprint key with:
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
AEGIS_FINGERPRINT_KEY=replace-with-a-random-local-value

# Provider-independent model routing
AI_PRIMARY_PROVIDER=nvidia
AI_PRIMARY_MODEL=replace-with-your-primary-model-name
AI_VERIFIER_PROVIDER=nvidia
AI_VERIFIER_MODEL=replace-with-your-verifier-model-name

# NVIDIA provider credentials and endpoint
NVIDIA_API_KEY=replace-with-your-provider-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional OpenRouter provider
# OPENROUTER_API_KEY=replace-with-your-openrouter-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional Groq provider
# GROQ_API_KEY=replace-with-your-groq-key
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional role-specific OpenAI-compatible endpoints
# AI_PRIMARY_API_KEY=replace-with-primary-provider-key
# AI_PRIMARY_BASE_URL=https://provider.example/v1
# AI_VERIFIER_API_KEY=replace-with-verifier-provider-key
# AI_VERIFIER_BASE_URL=https://provider.example/v1

# Legacy compatibility
# NVIDIA_MODEL and NVIDIA_VERIFIER_MODEL remain supported when the
# corresponding AI_PRIMARY_MODEL or AI_VERIFIER_MODEL value is unset.
# NVIDIA_MODEL=replace-with-your-primary-model-name
# NVIDIA_VERIFIER_MODEL=replace-with-your-verifier-model-name

# Model request behavior
AI_MAX_RETRIES=3
AI_REQUEST_TIMEOUT_SECONDS=60
