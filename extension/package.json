{
  "name": "aegis-security",
  "displayName": "Aegis Security",
  "description": "Evidence-backed security for AI-generated software: findings, fixes, independent verification, policy, and audit inside VS Code.",
  "version": "0.2.1",
  "publisher": "aegis-security",
  "preview": true,
  "pricing": "Free",
  "markdown": "github",
  "icon": "images/icon.png",
  "qna": "https://github.com/lemkyz/Aegis/issues",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Linters",
    "Other",
    "Testing"
  ],
  "activationEvents": [],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Aegis reads repository source and can coordinate explicitly authorized local validation."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Aegis requires a local repository and local backend."
    }
  },
  "main": "./dist/extension.js",
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "compile": "tsc -p ./",
    "watch": "tsc --watch -p ./",
    "check:manifest": "node --test ./test/manifest.test.mjs",
    "test": "npm run compile && node --test ./test/*.test.mjs",
    "package:list": "vsce ls",
    "package": "npm run clean && npm run compile && vsce package --no-dependencies",
    "verify:vsix": "node ./scripts/verify-vsix.mjs",
    "release:check": "npm test && npm run package && npm run verify:vsix"
  },
  "contributes": {
    "commands": [
      {
        "command": "aegis.fastScanSelectedCode",
        "title": "Aegis: Fast Scan Selected Code",
        "category": "Aegis",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "aegis.fastScanCurrentFile",
        "title": "Aegis: Fast Scan Current File",
        "category": "Aegis",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "aegis.scanWorkspace",
        "title": "Aegis: Scan Entire Workspace",
        "category": "Aegis",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "aegis.mapAttackSurface",
        "title": "Aegis: Map Attack Surface",
        "category": "Aegis",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "aegis.generateThreatModel",
        "title": "Aegis: Generate Threat Model",
        "category": "Aegis",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "aegis.showAttackGraph",
        "title": "Aegis: Show Attack Graph & Data Sentinel",
        "category": "Aegis",
        "enablement": "isWorkspaceTrusted",
        "icon": "$(graph)"
      },
      {
        "command": "aegis.previewSecurityTaskPlan",
        "title": "Aegis: Preview Security Task Plan",
        "category": "Aegis",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "aegis.runTrustedAnalysis",
        "title": "Aegis: Run Trusted Analysis",
        "category": "Aegis",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "aegis.scanDependencies",
        "title": "Aegis: Scan Dependencies",
        "category": "Aegis",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "aegis.deepAnalyzeSelectedCode",
        "title": "Aegis: Deep Analysis Selected Code",
        "category": "Aegis",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "aegis.runAuthorizedDynamicBaseline",
        "title": "Aegis: Run Authorized Dynamic Baseline",
        "category": "Aegis",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "aegis.applySecureFix",
        "title": "Aegis: Apply Secure Fix",
        "category": "Aegis",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "aegis.refreshSecurityView",
        "title": "Aegis: Refresh Security View",
        "category": "Aegis",
        "enablement": "isWorkspaceTrusted",
        "icon": "$(refresh)"
      },
      {
        "command": "aegis.scanUncommittedChanges",
        "title": "Aegis: Scan Uncommitted Changes",
        "category": "Aegis",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "aegis.scanStagedChanges",
        "title": "Aegis: Scan Staged Changes",
        "category": "Aegis",
        "enablement": "isWorkspaceTrusted"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "aegis.fastScanSelectedCode",
          "when": "editorHasSelection",
          "group": "aegis@1"
        },
        {
          "command": "aegis.fastScanCurrentFile",
          "when": "editorTextFocus",
          "group": "aegis@2"
        },
        {
          "command": "aegis.deepAnalyzeSelectedCode",
          "when": "editorHasSelection",
          "group": "aegis@3"
        },
        {
          "command": "aegis.runTrustedAnalysis",
          "when": "editorTextFocus",
          "group": "aegis@4"
        },
        {
          "command": "aegis.runAuthorizedDynamicBaseline",
          "when": "editorTextFocus",
          "group": "aegis@5"
        },
        {
          "command": "aegis.applySecureFix",
          "when": "editorHasSelection",
          "group": "aegis@6"
        }
      ],
      "explorer/context": [
        {
          "command": "aegis.scanWorkspace",
          "when": "explorerResourceIsFolder",
          "group": "aegis@1"
        }
      ],
      "view/title": [
        {
          "command": "aegis.refreshSecurityView",
          "when": "view == aegis.securityView",
          "group": "navigation"
        },
        {
          "command": "aegis.showAttackGraph",
          "when": "view == aegis.securityView",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Aegis",
      "properties": {
        "aegis.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Address of the local Aegis backend."
        },
        "aegis.trustedAnalysisTimeoutSeconds": {
          "type": "number",
          "default": 600,
          "minimum": 60,
          "maximum": 900,
          "scope": "machine",
          "description": "Total time budget for the production Trusted Analysis workflow, including primary and verifier model routes."
        },
        "aegis.showModelRouteMetadata": {
          "type": "boolean",
          "default": true,
          "description": "Show model providers, route classification, and independence details in Aegis security reports."
        },
        "aegis.warnOnNonIndependentVerification": {
          "type": "boolean",
          "default": true,
          "description": "Warn when multi-model verification used a route that Aegis does not classify as independent."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "aegis.securityView",
          "name": "Aegis Security",
          "when": "workspaceFolderCount > 0"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lemkyz/Aegis.git"
  },
  "license": "Apache-2.0",
  "homepage": "https://aegistrustlayer.com",
  "bugs": {
    "url": "https://github.com/lemkyz/Aegis/issues"
  },
  "keywords": [
    "security",
    "application-security",
    "ai-security",
    "ai-generated-code",
    "ai-agents",
    "software-agents",
    "trust-layer",
    "security-verification",
    "secure-coding",
    "code-analysis",
    "devsecops",
    "vulnerability",
    "sast",
    "evidence"
  ],
  "galleryBanner": {
    "color": "#F3EEE5",
    "theme": "light"
  }
}
