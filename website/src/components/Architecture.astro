<section class="architecture-card" aria-label="Aegis architecture diagram">
  <div class="architecture-top">
    <div class="surface-node"><small>Developer surface</small><strong>VS Code</strong><span>Interactive workspace</span></div>
    <div class="surface-node"><small>CI surface</small><strong>GitHub Action</strong><span>PR policy gate</span></div>
    <div class="surface-node"><small>Local surface</small><strong>CLI + API</strong><span>Deterministic path</span></div>
  </div>
  <div class="architecture-link"><span></span><i></i><span></span></div>
  <div class="architecture-core">
