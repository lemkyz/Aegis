      <div><small>Review</small><strong>Primary + verifier</strong></div>
      <div><small>Control</small><strong>Authorization + limits</strong></div>
      <div><small>Validation</small><strong>Sandbox + replay</strong></div>
      <div><small>Decision</small><strong>Policy + memory</strong></div>
    </div>
  </div>
  <div class="architecture-link down"><span></span><i></i><span></span></div>
  <div class="architecture-bottom">
    <span>Repository</span><span>Dependencies</span><span>Tests</span><span>Containers</span><span>Model providers*</span>
  </div>
