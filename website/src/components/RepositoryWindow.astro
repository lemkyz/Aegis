---
import Icon from './Icon.astro';
import { Content as Readme } from '../data/README.embed.md';
import { SITE } from '../config/site';
import github from '../data/github.snapshot.json';

const files = [
  ['dir', '.github'],
  ['dir', 'backend'],
  ['dir', 'brand'],
  ['dir', 'docs'],
  ['dir', 'examples'],
  ['dir', 'extension'],
  ['dir', 'scripts'],
  ['dir', 'security-engine/rules'],
  ['file', 'CHANGELOG.md'],
  ['file', 'CONTRIBUTING.md'],
  ['file', 'LICENSE'],
  ['file', 'NOTICE'],
  ['file', 'README.md'],
  ['file', 'SECURITY.md'],
  ['file', 'action.yml'],
] as const;
---
<div class="repo-browser" data-repo-browser>
  <header class="repo-browser__chrome">
    <div class="repo-browser__identity">
      <span class="repo-browser__gh"><Icon name="github" /></span>
      <div>
        <strong><span>lemkyz</span> / Aegis</strong>
        <small>{github.visibility === "public" ? "Public repository" : "Repository"} · synchronized at site build</small>
      </div>
    </div>
    <div class="repo-browser__actions">
      <button type="button" data-repo-tab="code" aria-selected="true">Code</button>
      <button type="button" data-repo-tab="readme" aria-selected="false">README</button>
      <button type="button" data-repo-tab="release" aria-selected="false">Release</button>
      <a href={SITE.github} target="_blank" rel="noopener noreferrer">Open GitHub <Icon name="external" /></a>
    </div>
  </header>

  <div class="repo-browser__subbar">
    <div class="repo-branch"><span aria-hidden="true">⑂</span><strong>{github.default_branch}</strong></div>
    <div class="repo-pulse"><i></i><span>real README snapshot</span></div>
    <div class="repo-stat"><strong>{github.commits ?? "—"}</strong><span>commits</span></div>
    <div class="repo-stat"><strong>{SITE.release}</strong><span>current preview</span></div>
  </div>

  <section class="repo-browser__panel" data-repo-panel="code">
    <aside class="repo-tree" aria-label="Repository files">
      <div class="repo-tree__head"><span>Files</span><small>main</small></div>
      <ul>
        {files.map(([kind, name]) => (
          <li class:list={{'is-readme': name === 'README.md'}}>
            <span class:list={['repo-file-icon', kind]} aria-hidden="true">{kind === 'dir' ? '⌗' : '·'}</span>
            <span>{name}</span>
          </li>
        ))}
      </ul>
      <a class="repo-tree__more" href={SITE.github} target="_blank" rel="noopener noreferrer">View all files <Icon name="arrow" /></a>
    </aside>

    <div class="repo-document-shell">
      <div class="repo-document-head">
        <div><strong>README.md</strong><span>Canonical public project overview</span></div>
        <div class="repo-document-meta"><span>Apache-2.0</span><span>VS Code · GitHub · CLI</span></div>
      </div>
      <div class="repo-readme" tabindex="0" aria-label="Scrollable build-time snapshot of the Aegis README">
        <article class="markdown-body"><Readme /></article>
      </div>
    </div>
  </section>

  <section class="repo-browser__panel" data-repo-panel="readme" hidden>
    <div class="repo-readme repo-readme--solo" tabindex="0">
      <article class="markdown-body"><Readme /></article>
    </div>
  </section>

  <section class="repo-browser__panel" data-repo-panel="release" hidden>
    <div class="repo-release-card">
      <div class="repo-release-card__top">
        <span class="mono">PUBLIC PREVIEW · {SITE.release}</span>
        <b>Observed fixture run</b>
      </div>
      <div class="repo-release-grid">
        <article><small>Deterministic evidence</small><strong>Semgrep + Bandit</strong><p>Scanner findings remain attached to provenance instead of being flattened into one opaque score.</p></article>
        <article><small>Primary review</small><strong class="mono">openai/gpt-oss-20b</strong><p>The primary model route is explicit in the evidence record.</p></article>
        <article><small>Independent verifier</small><strong class="mono">mistral-medium-3.5-128b</strong><p>The verifier is a separate role; model agreement alone does not become proof.</p></article>
        <article><small>Policy outcome</small><strong class="review">REVIEW · 75/100</strong><p>The vulnerable fixture remains an active claim, so Aegis asks for human resolution instead of claiming a clean result.</p></article>
      </div>
      <a class="btn btn--ghost repo-release-link" href={`${SITE.github}#what-a-real-run-produces`} target="_blank" rel="noopener noreferrer">Inspect the live README <Icon name="external" /></a>
    </div>
  </section>

  <footer class="repo-browser__footer">
    <p><strong>Not a screenshot.</strong> The README is fetched from the public repository during a production build and rendered locally into this static page. If GitHub is unavailable, the checked-in snapshot is used.</p>
    <a href={`${SITE.github}/blob/main/README.md`} target="_blank" rel="noopener noreferrer">Read on GitHub <Icon name="external" /></a>
  </footer>
</div>

<style>
.repo-browser{margin-top:12px;border:1px solid rgba(18,20,25,.2);border-radius:28px;overflow:hidden;background:#0d1117;color:#e7eaf0;box-shadow:0 38px 110px rgba(10,12,16,.18)}
.repo-browser__chrome{min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:0 20px;background:#11151b;border-bottom:1px solid rgba(255,255,255,.08)}
.repo-browser__identity{display:flex;align-items:center;gap:13px}.repo-browser__gh{display:grid;place-items:center;width:36px;height:36px;border:1px solid rgba(255,255,255,.09);border-radius:10px;background:#0d1117}.repo-browser__gh svg{width:19px;height:19px}.repo-browser__identity>div{display:grid;gap:4px}.repo-browser__identity strong{font-size:13px}.repo-browser__identity strong span{color:#c9ced6}.repo-browser__identity small{color:#858c96;font:650 9px/1 var(--font-mono)}
.repo-browser__actions{display:flex;align-items:center;gap:6px}.repo-browser__actions button,.repo-browser__actions a{min-height:34px;border:1px solid rgba(255,255,255,.09);border-radius:9px;background:#161b22;color:#aeb4bd;padding:0 12px;font:760 9px/1 var(--font-ui);display:inline-flex;align-items:center;gap:7px;cursor:pointer;transition:.2s ease}.repo-browser__actions button:hover,.repo-browser__actions button:focus-visible,.repo-browser__actions a:hover,.repo-browser__actions a:focus-visible{border-color:rgba(231,190,109,.4);color:#f0cf8d}.repo-browser__actions button[aria-selected="true"]{background:#f4f0e7;border-color:#f4f0e7;color:#111318}.repo-browser__actions svg{width:12px;height:12px}
.repo-browser__subbar{min-height:46px;padding:0 19px;display:flex;align-items:center;gap:18px;border-bottom:1px solid rgba(255,255,255,.07);background:#0f1319;color:#89909a}.repo-branch{display:flex;align-items:center;gap:7px;padding:6px 10px;border:1px solid rgba(255,255,255,.08);border-radius:7px;color:#c4c9d0;font:700 9px/1 var(--font-mono)}.repo-pulse{display:flex;align-items:center;gap:7px;font:650 8px/1 var(--font-mono);letter-spacing:.04em}.repo-pulse i{width:6px;height:6px;border-radius:50%;background:#51a378;box-shadow:0 0 0 4px rgba(81,163,120,.08)}.repo-stat{margin-left:auto;display:flex;align-items:baseline;gap:5px;font:650 8px/1 var(--font-mono)}.repo-stat+.repo-stat{margin-left:0}.repo-stat strong{color:#d8dce2}.repo-stat span{color:#777f89}
.repo-browser__panel{min-height:760px;background:#0d1117}.repo-browser__panel[data-repo-panel="code"]{display:grid;grid-template-columns:236px minmax(0,1fr)}.repo-tree{border-right:1px solid rgba(255,255,255,.07);background:#0f1319;padding:17px 12px 15px;position:relative}.repo-tree__head{display:flex;justify-content:space-between;align-items:center;padding:0 8px 12px;color:#c1c6ce}.repo-tree__head span{font-size:10px;font-weight:800}.repo-tree__head small{color:#747c86;font:650 8px/1 var(--font-mono)}.repo-tree ul{list-style:none;margin:0;padding:0;display:grid;gap:1px}.repo-tree li{height:34px;padding:0 8px;border-radius:6px;display:flex;align-items:center;gap:9px;color:#a5abb4;font:650 9.5px/1 var(--font-mono);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.repo-tree li.is-readme{background:rgba(209,162,75,.075);color:#e2c480}.repo-file-icon{width:14px;color:#707985;text-align:center}.repo-file-icon.dir{color:#d3ae67}.repo-tree__more{position:absolute;left:12px;right:12px;bottom:14px;height:36px;border-top:1px solid rgba(255,255,255,.07);padding-top:13px;color:#e4c071;font-size:9px;font-weight:800;display:flex;align-items:center;gap:7px}.repo-tree__more svg{width:12px;height:12px}
.repo-document-shell{min-width:0;background:#0d1117}.repo-document-head{height:54px;padding:0 20px;border-bottom:1px solid rgba(255,255,255,.07);display:flex;justify-content:space-between;align-items:center;gap:20px;background:#11151b}.repo-document-head>div:first-child{display:grid;gap:3px}.repo-document-head strong{font-size:11px}.repo-document-head span{color:#7d858f;font:650 8px/1 var(--font-mono)}.repo-document-meta{display:flex;gap:7px}.repo-document-meta span{padding:5px 8px;border:1px solid rgba(255,255,255,.08);border-radius:999px;background:#0d1117;color:#9ba2ac}
.repo-readme{height:760px;overflow:auto;background:#0d1117;scrollbar-width:thin;scrollbar-color:#3f4650 #11151b}.repo-readme--solo{height:820px}.markdown-body{max-width:940px;margin:0 auto;padding:54px 64px 100px;color:#c9ced5;font-size:14px;line-height:1.72}.markdown-body>p[align="center"]{text-align:center}.markdown-body .repo-readme-title{font-size:3rem;letter-spacing:-.055em;color:#f2eee6;text-align:center;margin:18px 0 8px;border:0;padding:0}.markdown-body h2{font-size:1.75rem;letter-spacing:-.035em;color:#ece8df;margin:58px 0 16px;padding-bottom:10px;border-bottom:1px solid rgba(255,255,255,.08)}.markdown-body h3{font-size:1.1rem;color:#e1ded7;margin:32px 0 12px}.markdown-body p{color:#b3bac3}.markdown-body strong{color:#e9e5dc}.markdown-body code{font:650 .88em/1.5 var(--font-mono);color:#ebc87d;background:#161b22;border:1px solid rgba(255,255,255,.06);padding:.15em .35em;border-radius:5px}.markdown-body pre{overflow:auto;padding:18px 20px;border:1px solid rgba(255,255,255,.08);border-radius:10px;background:#080c12;color:#d5d9df}.markdown-body pre code{border:0;background:transparent;padding:0;color:#c7ccd4}.markdown-body table{width:100%;border-collapse:collapse;margin:21px 0 28px;font-size:12px}.markdown-body th,.markdown-body td{border:1px solid rgba(255,255,255,.09);padding:11px 13px;text-align:left;vertical-align:top}.markdown-body th{background:#151a21;color:#e7e3db}.markdown-body td{color:#abb2bc}.markdown-body ul{padding-left:22px;color:#b3bac3}.markdown-body li{margin:7px 0}.markdown-body a{color:#edc979;border-bottom:1px solid rgba(237,201,121,.3)}.markdown-body img{display:block;max-width:144px;margin:0 auto}.markdown-body .mermaid{display:none}
.repo-release-card{min-height:760px;padding:56px;background:radial-gradient(circle at 82% 12%,rgba(209,162,75,.12),transparent 30%),#0d1117}.repo-release-card__top{display:flex;justify-content:space-between;gap:20px;align-items:center;padding-bottom:22px;border-bottom:1px solid rgba(255,255,255,.08)}.repo-release-card__top span{color:#d9b66f;font-size:9px;letter-spacing:.12em}.repo-release-card__top b{font-size:12px}.repo-release-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:42px 0}.repo-release-grid article{min-height:220px;padding:24px;border:1px solid rgba(255,255,255,.08);border-radius:14px;background:#11161d}.repo-release-grid small{display:block;color:#7f8791;font:700 8px/1 var(--font-mono);text-transform:uppercase;letter-spacing:.09em}.repo-release-grid strong{display:block;color:#ece8df;font-size:1.2rem;margin:40px 0 11px}.repo-release-grid strong.review{color:#e6bd67}.repo-release-grid p{margin:0;color:#9da4ad;font-size:11.5px;line-height:1.65}.repo-release-link{border-color:rgba(255,255,255,.15);color:#e7e2d8}.repo-browser__footer{display:flex;justify-content:space-between;align-items:center;gap:30px;padding:17px 20px;background:#11151b;border-top:1px solid rgba(255,255,255,.07)}.repo-browser__footer p{max-width:820px;margin:0;color:#8e959e;font-size:10.5px;line-height:1.55}.repo-browser__footer p strong{color:#d4d8de}.repo-browser__footer a{flex:0 0 auto;display:flex;align-items:center;gap:7px;color:#e8c374;font-size:10px;font-weight:800}.repo-browser__footer svg{width:12px;height:12px}
@media(max-width:900px){.repo-browser__chrome{align-items:flex-start;flex-direction:column;padding:16px 18px}.repo-browser__actions{width:100%;overflow-x:auto}.repo-browser__panel[data-repo-panel="code"]{grid-template-columns:1fr}.repo-tree{display:none}.repo-readme,.repo-readme--solo{height:700px}.markdown-body{padding:42px 28px 80px}.repo-browser__subbar{overflow-x:auto}.repo-stat{margin-left:0}.repo-release-card{padding:34px}.repo-release-grid{grid-template-columns:1fr}}
@media(max-width:600px){.repo-browser{border-radius:18px}.repo-browser__actions a{margin-left:auto}.repo-browser__panel{min-height:620px}.repo-readme,.repo-readme--solo{height:620px}.markdown-body{padding:34px 20px 70px;font-size:13px}.markdown-body h1{font-size:2.35rem}.repo-document-head{height:auto;min-height:58px;padding:11px 14px}.repo-document-meta{display:none}.repo-release-card{min-height:620px;padding:28px 18px}.repo-browser__footer{align-items:flex-start;flex-direction:column}}
@media(prefers-reduced-motion:reduce){.repo-browser__actions button,.repo-browser__actions a{transition:none}}
</style>
