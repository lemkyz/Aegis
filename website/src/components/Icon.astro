---
interface Props { name: 'arrow' | 'github' | 'terminal' | 'check' | 'shield' | 'external' | 'menu' | 'close' | 'search'; }
const { name } = Astro.props;
---
{name === 'arrow' && <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 6l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>}
{name === 'external' && <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 5H5.5A1.5 1.5 0 0 0 4 6.5v8A1.5 1.5 0 0 0 5.5 16h8a1.5 1.5 0 0 0 1.5-1.5V13M10 4h6v6M16 4l-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>}
{name === 'github' && <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .8a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.2c-3.23.7-3.91-1.37-3.91-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.78 1.2 1.78 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.58-.3-5.3-1.29-5.3-5.73 0-1.27.46-2.3 1.2-3.11-.12-.3-.52-1.48.11-3.07 0 0 .98-.31 3.16 1.19a10.9 10.9 0 0 1 5.77 0c2.18-1.5 3.16-1.19 3.16-1.19.63 1.59.23 2.77.11 3.07.75.81 1.2 1.84 1.2 3.11 0 4.45-2.72 5.43-5.31 5.72.42.36.79 1.07.79 2.16v3.21c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .8Z"/></svg>}
{name === 'terminal' && <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 6 3.5 4L4 14m5.5 0H16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>}
{name === 'check' && <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 10 3.5 3.5L16 5.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>}
{name === 'shield' && <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2.7 16 5v4.4c0 3.8-2.3 6.2-6 7.9-3.7-1.7-6-4.1-6-7.9V5l6-2.3Z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m7.1 10 1.8 1.8 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>}
{name === 'menu' && <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 14h14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>}
{name === 'close' && <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>}

{name === 'search' && <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="4.8" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="m12 12 4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>}
