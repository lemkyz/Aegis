---
import Icon from './Icon.astro';
---
<div class="boundary-explorer" data-boundary-explorer>
  <div class="boundary-menu" role="tablist" aria-label="Security and data boundaries">
    <button type="button" class="active" role="tab" aria-selected="true" data-boundary="local"><span>01</span><div><strong>Local by default</strong><small>Deterministic path</small></div></button>
    <button type="button" role="tab" aria-selected="false" data-boundary="models"><span>02</span><div><strong>Model boundary</strong><small>Optional + explicit</small></div></button>
    <button type="button" role="tab" aria-selected="false" data-boundary="validation"><span>03</span><div><strong>Controlled validation</strong><small>Separate authorization</small></div></button>
    <button type="button" role="tab" aria-selected="false" data-boundary="website"><span>04</span><div><strong>Public website</strong><small>Static attack surface</small></div></button>
  </div>

  <div class="boundary-stage">
    <div class="boundary-stage__top">
      <span class="mono">TRUST BOUNDARY</span>
      <strong data-boundary-status>LOCAL</strong>
    </div>
    <div class="boundary-visual" aria-hidden="true">
      <div class="boundary-device"><i></i><span>Developer machine</span><b>AEGIS</b></div>
      <div class="boundary-flow"><span></span><i>→</i><span></span></div>
      <div class="boundary-target"><small data-boundary-target-cap>DEFAULT DESTINATION</small><strong data-boundary-target>Local evidence + policy</strong><em data-boundary-target-state>No network required</em></div>
    </div>
    <div class="boundary-copy">
      <p class="eyebrow" data-boundary-eyebrow>Deterministic workflow</p>
      <h3 data-boundary-title>Security analysis can stay on the developer machine.</h3>
      <p data-boundary-body>Deterministic scans, policy evaluation, audit records, and project security memory remain local in the current VS Code workflow. A model provider is not required for the deterministic path.</p>
      <div class="boundary-facts" data-boundary-facts>
        <span><Icon name="shield" /> no product telemetry in 0.2.0</span>
        <span><Icon name="shield" /> local loopback backend</span>
        <span><Icon name="shield" /> evidence stays inspectable</span>
      </div>
    </div>
  </div>
</div>

<style>
.boundary-explorer{display:grid;grid-template-columns:320px minmax(0,1fr);border:1px solid var(--line-strong);border-radius:26px;overflow:hidden;background:#f5f0e6;box-shadow:0 30px 85px rgba(16,18,22,.08)}.boundary-menu{padding:11px;background:#eae3d7;border-right:1px solid var(--line);display:grid;gap:7px;align-content:start}.boundary-menu button{appearance:none;border:1px solid transparent;border-radius:15px;background:transparent;padding:19px 16px;display:grid;grid-template-columns:28px 1fr;gap:10px;text-align:left;cursor:pointer;color:var(--ink);transition:.2s ease}.boundary-menu button:hover,.boundary-menu button:focus-visible{background:rgba(255,255,255,.58);transform:translateX(2px)}.boundary-menu button.active,.boundary-menu button[aria-selected="true"]{background:#fffdf8;border-color:rgba(18,20,25,.14);box-shadow:0 10px 30px rgba(16,18,22,.05)}.boundary-menu button>span{color:var(--gold-deep);font:800 8px/1 var(--font-mono);padding-top:4px}.boundary-menu button div{display:grid;gap:5px}.boundary-menu strong{font-size:13px}.boundary-menu small{color:#66625b;font-size:10px}.boundary-stage{padding:30px 34px 34px;background:#fffdf8;min-width:0}.boundary-stage__top{display:flex;justify-content:space-between;align-items:center;padding-bottom:18px;border-bottom:1px solid var(--line)}.boundary-stage__top span{font-size:8px;letter-spacing:.12em;color:#7c7468}.boundary-stage__top strong{font:850 9px/1 var(--font-mono);letter-spacing:.11em;color:#8b6118}.boundary-visual{display:grid;grid-template-columns:1fr 100px 1fr;align-items:center;margin:38px 0;min-height:190px}.boundary-device,.boundary-target{min-height:145px;border:1px solid var(--line-strong);border-radius:16px;background:#f3eee4;padding:20px;display:flex;flex-direction:column;justify-content:center;position:relative;overflow:hidden}.boundary-device::after,.boundary-target::after{content:"";position:absolute;width:110px;height:110px;border:1px solid rgba(169,120,37,.14);border-radius:50%;right:-50px;bottom:-45px}.boundary-device i{width:8px;height:8px;border-radius:50%;background:#4f9a76;box-shadow:0 0 0 5px rgba(79,154,118,.1);margin-bottom:24px}.boundary-device span,.boundary-target small{color:#6a665e;font:700 8px/1 var(--font-mono);text-transform:uppercase;letter-spacing:.08em}.boundary-device b,.boundary-target strong{font-size:21px;margin-top:7px}.boundary-target em{margin-top:9px;color:#5c5952;font:700 9px/1.3 var(--font-mono);font-style:normal}.boundary-flow{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:8px;color:#a87a2c}.boundary-flow span{height:1px;background:rgba(169,120,37,.35)}.boundary-flow i{font-style:normal;font-size:18px}.boundary-copy{max-width:820px}.boundary-copy h3{font-size:clamp(2rem,3vw,3.5rem);max-width:760px;margin:12px 0 14px}.boundary-copy>p:not(.eyebrow){color:#44433e;max-width:760px;font-size:14.5px;line-height:1.72}.boundary-facts{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}.boundary-facts span{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line);border-radius:999px;padding:8px 11px;background:#f5f0e6;color:#504d46;font:700 9px/1 var(--font-mono)}.boundary-facts svg{width:12px;height:12px;color:#a77420}
@media(max-width:900px){.boundary-explorer{grid-template-columns:1fr}.boundary-menu{grid-template-columns:repeat(2,1fr);border-right:0;border-bottom:1px solid var(--line)}}@media(max-width:620px){.boundary-menu{grid-template-columns:1fr}.boundary-stage{padding:24px 18px}.boundary-visual{grid-template-columns:1fr;gap:14px}.boundary-flow{grid-template-columns:1fr;justify-items:center}.boundary-flow span{display:none}.boundary-flow i{transform:rotate(90deg)}.boundary-facts{display:grid}.boundary-facts span{border-radius:10px}}
@media(prefers-reduced-motion:reduce){.boundary-menu button{transition:none}.boundary-menu button:hover,.boundary-menu button:focus-visible{transform:none}}
</style>
